# Environment Configuration
ENV=development
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aegis_quant_ai
REDIS_URL=redis://localhost:6379/0

# MT5 Configuration
MT5_LOGIN=YOUR_MT5_LOGIN
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER
MT5_PATH=/path/to/terminal64.exe

# Broker Configuration
BROKER_TYPE=exness
BROKER_LOGIN=YOUR_LOGIN
BROKER_PASSWORD=YOUR_PASSWORD

# Risk Management
PORTFOLIO_RISK_PERCENT=2.0
PER_TRADE_RISK_PERCENT=1.0
MAX_DRAWDOWN_PERCENT=10.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Telegram Bot
TELEGRAM_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# AI Models
AI_MODEL_PATH=./models
LEARNING_ENABLED=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aegis.log

# Backtest
BACKTEST_YEARS=5
MONTE_CARLO_ITERATIONS=10000
